{
  "name": "fileshare",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "server": "bun run server/index.ts",
    "client": "bun run client/index.ts",
    "test": "bun test",
    "build:client:linux-x64": "bun build client/index.ts --compile --target bun-linux-x64 --outfile dist/fileshare-linux-x64",
    "build:client:linux-arm64": "bun build client/index.ts --compile --target bun-linux-arm64 --outfile dist/fileshare-linux-arm64",
    "build:client:darwin-x64": "bun build client/index.ts --compile --target bun-darwin-x64 --outfile dist/fileshare-darwin-x64",
    "build:client:darwin-arm64": "bun build client/index.ts --compile --target bun-darwin-arm64 --outfile dist/fileshare-darwin-arm64",
    "build:client:windows": "bun build client/index.ts --compile --target bun-windows-x64 --outfile dist/fileshare-windows-x64.exe",
    "build:all": "bun run build:client:linux-x64 && bun run build:client:linux-arm64 && bun run build:client:darwin-x64 && bun run build:client:darwin-arm64 && bun run build:client:windows"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
